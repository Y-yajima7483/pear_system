# Secretless reference for the optional Docker deployment.
# Inject real secrets from the deployment platform at runtime. Never commit a
# populated copy of this file.

NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080
APP_ORIGIN=https://app.example.invalid

# Required secrets. Intentionally blank.
APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Non-secret deployment-specific identifiers.
DB_DATABASE=pear_app
DB_USERNAME=pear_app
SANCTUM_STATEFUL_DOMAINS=app.example.invalid
SESSION_DOMAIN=app.example.invalid
SESSION_SECURE_COOKIE=true
# 60日（2ヶ月）を分で指定
SESSION_LIFETIME=86400
