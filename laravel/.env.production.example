# Secretless Laravel production contract.
# Supply real values from the runtime secret/configuration store. Do not copy a
# populated production environment file into a source tree or image.

APP_NAME="PEAR System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.invalid

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Canonical native topology uses a loopback database endpoint. Real connection
# values remain in the private runtime configuration.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pear_app
DB_USERNAME=pear_app
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=app.example.invalid
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=app.example.invalid
CORS_ALLOWED_ORIGINS=https://app.example.invalid

FILESYSTEM_DISK=local
HASHING_DRIVER=argon2id
